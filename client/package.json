{
  "name": "@outcry/client",
  "version": "0.1.0",
  "description": "TypeScript client for the Outcry on-chain card-trading table (MagicBlock PER)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@magicblock-labs/ephemeral-rollups-sdk": "0.18.0",
    "@solana/web3.js": "^1.98.4",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
